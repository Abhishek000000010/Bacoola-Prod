# =========================================================================
# Bacoola — Medusa backend environment template
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Keep all brand/secret values here — never hardcode them in source.
# =========================================================================

# --- Database (Neon PostgreSQL) -------------------------------------------
# Your Neon connection string. Create a project at https://neon.tech and copy
# the pooled connection string. Format:
#   postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=

# --- CORS ------------------------------------------------------------------
# Comma-separated origins allowed to call the store/admin/auth APIs.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

# --- Secrets ---------------------------------------------------------------
# Replace with strong random values in any shared/production environment.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# --- Cloudinary (file storage) ---------------------------------------------
# Media uploads (product images, etc.) go to Cloudinary. Get these from your
# Cloudinary dashboard (https://cloudinary.com). Uploads fail without them, but
# the server still boots, so you can run everything else before filling these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder assets are uploaded into (rename per brand).
CLOUDINARY_FOLDER=bacoola

# --- Razorpay (payments) ---------------------------------------------------
# Payments use Razorpay (works in India; the store/region currency is INR).
# Get test/live keys from the Razorpay dashboard (https://dashboard.razorpay.com).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: merchant account id and webhook secret (for production webhooks).
RAZORPAY_ACCOUNT=
RAZORPAY_WEBHOOK_SECRET=

# --- SendGrid (transactional email) ----------------------------------------
# Order-confirmation emails (to the customer) and new-order notifications (to
# the store) are sent via SendGrid when an order is placed
# (src/subscribers/order-confirmation-email.ts). If SENDGRID_API_KEY or
# SENDGRID_FROM_EMAIL is missing, email is skipped (logged) and checkout still
# works — so you can leave these blank until you're ready.
#
# API key: SendGrid → Settings → API Keys (give it "Mail Send" permission).
SENDGRID_API_KEY=
# The "from" address. MUST be a verified sender in SendGrid (Settings → Sender
# Authentication → Single Sender, or a verified domain). SendGrid silently drops
# mail sent from an unverified address.
SENDGRID_FROM_EMAIL=
# Optional display name shown to recipients (e.g. "Bacoola Store").
SENDGRID_FROM_NAME=
# Where the store-owner "new order" notification is sent (can be your own inbox).
# Leave blank to skip the owner notification and only email the customer.
ORDER_NOTIFICATION_EMAIL=
# Optional. Brand name shown in the email header/subject. Defaults to "Bacoola".
EMAIL_BRAND_NAME=Bacoola
# Optional. Public storefront base URL, used to build the "Shop now" link in the
# back-in-stock email (e.g. https://bacoola.com or http://localhost:8000/in).
# If unset the email simply omits the button.
STOREFRONT_URL=

# --- Shiprocket (shipping / fulfillment) -----------------------------------
# Orders are pushed to Shiprocket when a fulfillment is created (auto-created on
# checkout by src/subscribers/auto-fulfill-order.ts). Get credentials from your
# Shiprocket dashboard. Create an API user under Settings → API → Configure.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# The pickup address *nickname* exactly as shown in Shiprocket under
# Settings → Company → Pickup Addresses (e.g. "Primary"). Order creation fails
# if this doesn't match an existing pickup location. Defaults to "Primary".
SHIPROCKET_PICKUP_LOCATION=Primary
# Optional: token for authenticating inbound Shiprocket status webhooks
# (POST /hooks/fulfillment/delivery-updates, header x-api-key).
SHIPROCKET_WEBHOOK_TOKEN=

# --- Redis (Upstash) -------------------------------------------------------
# Backs the cache, event bus, workflow engine and distributed locking.
# Leave unset to fall back to the in-memory implementations — those boot fine
# but drop queued jobs on restart and cannot lock across requests/instances,
# so they are NOT safe for production (see docs/WEBSITE-ANALYSIS.md, A1).
#
# Get this from https://console.upstash.com → your database → "Redis" tab →
# copy the TLS endpoint. Format:
#   rediss://default:<TOKEN>@<name>-<id>.upstash.io:6379
# Note the double 's' in rediss:// — Upstash is TLS-only.
REDIS_URL=

# Optional. Prefixes cache keys and the BullMQ queue name so several
# environments can safely share one Upstash database. Set this to something
# distinct per environment (e.g. "bacoola-dev" locally, "bacoola-prod" on
# Render) if you are NOT giving each environment its own Upstash DB.
# REDIS_NAMESPACE=bacoola-dev

# --- Admin onboarding (set by create-medusa-app; safe to leave) ------------
MEDUSA_ADMIN_ONBOARDING_TYPE=nextjs
MEDUSA_ADMIN_ONBOARDING_NEXTJS_DIRECTORY=apps\storefront

DB_NAME=
# --- Admin password reset ---------------------------------------------------
# Medusa's admin already has a "Forgot password?" flow: it mints a single-use
# token (15-minute expiry) and emits `auth.password_reset`. It does NOT send any
# email — src/subscribers/admin-password-reset-email.ts does that.
#
# Comma-separated allowlist of admin addresses permitted to reset by email.
# A reset requested for any other account is logged and dropped.
#
# Leave this BLANK and nobody can reset by email (it fails closed on purpose).
# Recovery then goes through the server:
#   docker exec bacoola-backend npx medusa user -e <email> -p <new-password>
#
# Note Medusa only ever mails the address ON the account, so a stranger typing
# their own address into the form receives nothing regardless of this setting.
# This is a second, narrower gate for accounts created later.
ADMIN_PASSWORD_RESET_EMAILS=
# Where the admin dashboard is served, used to build the reset link
# (e.g. https://api.bacoola.com — the link becomes <ADMIN_URL>/app/reset-password).
# Falls back to the first ADMIN_CORS origin when unset.
ADMIN_URL=
